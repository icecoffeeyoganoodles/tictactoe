<Window x:Class="TicTacToe.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tic Tac Toe - EASI" Height="800" Width="650"
        Background="#F4F7FA" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- palette de couleurs easi -->
        <SolidColorBrush x:Key="EasiBlue" Color="#00478F"/>
        <SolidColorBrush x:Key="EasiRed" Color="#E30613"/>
        <SolidColorBrush x:Key="DarkText" Color="#1E293B"/>

        <!-- style pour les boutons d'action (lancer / rejouer) -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource EasiBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#003366"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- style pour les cases de la grille -->
        <Style x:Key="CellButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="48" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <!-- effet d'ombre douce -->
                            <Border.Effect>
                                <DropShadowEffect Color="#CBD5E1" BlurRadius="10" ShadowDepth="3" Opacity="0.6"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- en-tête -->
            <RowDefinition Height="Auto"/> <!-- config -->
            <RowDefinition Height="Auto"/> <!-- statut -->
            <RowDefinition Height="*"/>    <!-- grille -->
            <RowDefinition Height="Auto"/> <!-- rejouer -->
        </Grid.RowDefinitions>

        <!-- en-tête avec logo textuel -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
            <TextBlock Text="EASI" FontSize="36" FontWeight="Black" Foreground="{StaticResource EasiBlue}" Margin="0,0,10,0"/>
            <TextBlock Text="Tic Tac Toe" FontSize="36" FontWeight="Light" Foreground="{StaticResource DarkText}"/>
        </StackPanel>

        <!-- panneau de configuration -->
        <StackPanel Grid.Row="1" x:Name="ConfigPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
            <TextBlock Text="choix du pion :" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="{StaticResource DarkText}" FontWeight="SemiBold"/>
            <RadioButton x:Name="RadioX" Content="X (croix)" IsChecked="True" Margin="0,0,15,0" VerticalAlignment="Center" Foreground="{StaticResource EasiBlue}" FontWeight="Bold"/>
            <RadioButton x:Name="RadioO" Content="O (rond)" Margin="0,0,25,0" VerticalAlignment="Center" Foreground="{StaticResource EasiRed}" FontWeight="Bold"/>

            <!-- choix taille grille -->
            <TextBlock Text="taille :" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource DarkText}" FontWeight="SemiBold"/>
            <!-- le nouveau champ de texte -->
            <TextBox x:Name="GridSizeInput" Text="3" VerticalAlignment="Center" Margin="0,0,20,0" Width="40" Padding="5,2" FontSize="14" TextAlignment="Center" FontWeight="Bold"/>

            <Button Content="lancer la partie" Click="StartGame_Click" Style="{StaticResource ActionButtonStyle}"/>
        </StackPanel>

        <!-- bulle de statut -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="10,15" Margin="0,0,0,25" HorizontalAlignment="Center" MinWidth="350">
            <Border.Effect>
                <DropShadowEffect Color="#CBD5E1" BlurRadius="5" ShadowDepth="2" Opacity="0.3"/>
            </Border.Effect>
            <TextBlock x:Name="StatusText" Text="en attente de lancement..." TextAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource DarkText}"/>
        </Border>

        <!-- grille de jeu -->
        <UniformGrid Grid.Row="3" x:Name="GameGrid" Rows="3" Columns="3" Width="360" Height="360" HorizontalAlignment="Center" VerticalAlignment="Center">
        </UniformGrid>

        <!-- bouton rejouer -->
        <Button Grid.Row="4" x:Name="RestartButton" Content="rejouer" Click="Restart_Click" Style="{StaticResource ActionButtonStyle}" Margin="0,25,0,0" Visibility="Collapsed" HorizontalAlignment="Center" Width="150"/>
    </Grid>
</Window>