<Window x:Class="TicTacToe.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tic Tac Toe" Height="450" Width="400">
    
    <StackPanel Margin="20">
        <StackPanel
            x:Name="ConfigPanel"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,0,0,20">
            <RadioButton x:Name="RadioX" Content="croix (x)" IsChecked="True" Margin="0,0,15,0"/>
            <RadioButton x:Name="RadioO" Content="rond (o)" Margin="0,0,15,0"/>
            <Button Content="lancer la partie" Click="StartGame_Click" Padding="10,5"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Text="en attente de lancement..." TextAlignment="Center" FontSize="16" Margin="0,0,0,20" FontWeight="Bold"/>

        <UniformGrid x:Name="GameGrid" Rows="3" Columns="3" Width="300" Height="300">
        </UniformGrid>

        <Button x:Name="RestartButton" Content="rejouer" Click="Restart_Click" Padding="10,5" Margin="0,20,0,0" Visibility="Collapsed" Width="100" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>