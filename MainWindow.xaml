<Window x:Class="TicTacToe.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tic Tac Toe - EASI" Height="800" Width="650"
        Background="#131032" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- couleurs d'Easi -->
        <SolidColorBrush x:Key="EasiDark" Color="#131032"/>
        <SolidColorBrush x:Key="EasiCoral" Color="#FF8474"/>
        <SolidColorBrush x:Key="EasiCard" Color="#1E1A4B"/>
        <SolidColorBrush x:Key="TextWhite" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#A09EBC"/>

        <!-- style pour les boutons d'action (lancer / rejouer) -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource EasiCoral}"/>
            <Setter Property="Foreground" Value="{StaticResource TextWhite}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF9E91"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- style pour les cases de la grille -->
        <Style x:Key="CellButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource TextWhite}" />
            <Setter Property="FontSize" Value="48" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="5" Opacity="0.2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- en-tête -->
            <RowDefinition Height="Auto"/> <!-- config -->
            <RowDefinition Height="Auto"/> <!-- statut -->
            <RowDefinition Height="*"/>    <!-- grille -->
            <RowDefinition Height="Auto"/> <!-- rejouer -->
        </Grid.RowDefinitions>

        <!-- en-tête avec logo textuel -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,35">
            <TextBlock Text="easi" FontSize="42" FontWeight="Black" Foreground="{StaticResource EasiCoral}" Margin="0,0,10,0"/>
            <TextBlock Text="Tic Tac Toe" FontSize="42" FontWeight="Light" Foreground="{StaticResource TextWhite}"/>
        </StackPanel>

        <!-- panneau de configuration -->
        <StackPanel Grid.Row="1" x:Name="ConfigPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
            <TextBlock Text="choix du pion :" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="{StaticResource TextWhite}" FontWeight="SemiBold"/>
            <RadioButton x:Name="RadioX" Content="X (croix)" IsChecked="True" Margin="0,0,15,0" VerticalAlignment="Center" Foreground="{StaticResource TextWhite}" FontWeight="Bold"/>
            <RadioButton x:Name="RadioO" Content="O (rond)" Margin="0,0,25,0" VerticalAlignment="Center" Foreground="{StaticResource TextWhite}" FontWeight="Bold"/>

            <!-- choix taille grille -->
            <TextBlock Text="taille :" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextWhite}" FontWeight="SemiBold"/>
            <TextBox x:Name="GridSizeInput" Text="3" VerticalAlignment="Center" Margin="0,0,20,0" Width="40" Padding="5,2" FontSize="14" TextAlignment="Center" FontWeight="Bold" Background="{StaticResource EasiCard}" Foreground="{StaticResource TextWhite}" BorderThickness="0"/>

            <Button Content="lancer la partie" Click="StartGame_Click" Style="{StaticResource ActionButtonStyle}"/>
        </StackPanel>

        <!-- bulle de statut -->
        <Border Grid.Row="2" Background="{StaticResource EasiCard}" CornerRadius="8" Padding="10,15" Margin="0,0,0,25" HorizontalAlignment="Center" MinWidth="350">
            <TextBlock x:Name="StatusText" Text="en attente de lancement..." TextAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextWhite}"/>
        </Border>

        <!-- grille de jeu -->
        <UniformGrid Grid.Row="3" x:Name="GameGrid" Rows="3" Columns="3" Width="360" Height="360" HorizontalAlignment="Center" VerticalAlignment="Center">
        </UniformGrid>

        <!-- bouton rejouer -->
        <Button Grid.Row="4" x:Name="RestartButton" Content="rejouer" Click="Restart_Click" Style="{StaticResource ActionButtonStyle}" Margin="0,25,0,0" Visibility="Collapsed" HorizontalAlignment="Center" Width="150"/>
    </Grid>
</Window>